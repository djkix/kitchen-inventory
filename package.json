{
  "name": "kitchen-inventory",
  "version": "0.0.0",
  "private": true,
  "description": "Inventaire alimentaire auto-hébergé : scan, péremptions, recettes",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run build:shared && npm test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "prisma": "prisma --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "build:shared": "npm run build -w @kitchen/shared",
    "lint:fix": "eslint . --fix",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --wait",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "e2e": "playwright test --config e2e/playwright.config.ts --project=chromium",
    "e2e:sans-fournisseur": "playwright test --config e2e/playwright.config.ts --project=chromium-sans-fournisseur"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "embedded-postgres": "^16.14.0-beta.17",
    "eslint": "^10.11.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "embedded-postgres@16.14.0-beta.17": true,
    "@embedded-postgres/darwin-arm64@16.14.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "fsevents@2.3.3": true,
    "@embedded-postgres/linux-x64@16.14.0-beta.17": true,
    "@embedded-postgres/linux-arm64@16.14.0-beta.17": true,
    "@swc/core@1.16.2": true,
    "esbuild@0.28.2": true
  }
}

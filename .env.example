# Copier ce fichier vers .env et renseigner les valeurs. Ne jamais commiter .env.
#
# Le TLS et le nom de domaine sont assurés par le reverse proxy devant la stack :
# l'accès caméra du téléphone exige HTTPS (section 8 du cahier des charges).

# ---- Général ----
TZ=Europe/Paris

# Tag de l'image déployée. « latest » redéploie un contenu différent à chaque
# fusion sur main ; en production, préférer une version précise (ex. 0.3.1).
IMAGE_TAG=latest

# Adresse et port sur l'hôte, consommés par le reverse proxy uniquement.
BIND_ADDRESS=127.0.0.1
APP_PORT=8888

# URL publique telle que vue par le téléphone (scheme inclus).
PUBLIC_URL=https://kitchen.example.org

# ---- Sécurité ----
# Obligatoire, 32 caractères minimum. Générer : openssl rand -hex 32
SECRET_KEY=__REMPLACER__

# Client ID OAuth « Application web » de la console Google Cloud (section 10).
# Public, pas un secret : aucun client secret n'est nécessaire avec le flux
# « jeton d'identité ». Vide = la connexion Google est indisponible et le
# bouton ne s'affiche pas. Les étapes de la console sont dans le README,
# section « Première connexion ».
GOOGLE_CLIENT_ID=

# GOOGLE_CERTS_URL — NE JAMAIS POSER ICI.
# Réservée au montage de tests bout en bout (`docker-compose.e2e.yml`), qui doit
# vérifier une vraie signature sans réseau. Elle remplace la source des clés
# publiques qui valident les jetons Google : renseignée en production, elle
# déplace la racine de confiance de l'authentification — qui sert ces clés signe
# des jetons que l'application acceptera. Laissée absente, les clés viennent de
# Google. Si elle est posée malgré tout, l'application l'annonce au démarrage
# (avertissement dans le journal) et `/health` la rend visible dans `degraded`
# sous le nom `google_certs_url`.

# ---- PostgreSQL ----
POSTGRES_USER=kitchen
# Générer : openssl rand -hex 24
POSTGRES_PASSWORD=__REMPLACER__
POSTGRES_DB=kitchen
# Répertoire hôte des données PostgreSQL.
PGDATA_DIR=./pgdata

# ---- Médias ----
# Photos des produits et des scans (la base ne garde que les chemins).
MEDIA_DIR=./media

# ---- Reconnaissance photo (section 5, niveau 4) ----
# none | gemini | anthropic | openai | ollama. Désactivé tant qu'aucune clé
# n'est saisie : le scan de code-barres et Open Food Facts fonctionnent sans.
# Fournisseur retenu : gemini. Clé à créer sur https://aistudio.google.com/apikey
VISION_PROVIDER=gemini
VISION_API_KEY=
# Modèle du fournisseur photo. Défaut : gemini-3.8-flash.
VISION_MODEL=
# URL de base pour un modèle local (ollama) ou un proxy compatible.
VISION_BASE_URL=
# Appels photo autorisés par jour ; au-delà, 429 avec le compteur (section 17).
VISION_DAILY_QUOTA=50
# Appels de suggestion de recettes autorisés par jour (EF-26), compteur séparé
# du scan photo ci-dessus : au-delà, la dernière fournée connue est resservie.
RECIPE_SUGGESTION_DAILY_QUOTA=20
# Lectures de ticket de caisse autorisées par jour (EF-29), compteur séparé
# du scan photo et des suggestions.
RECEIPT_DAILY_QUOTA=10
# Plafond de dépense mensuel en centimes (500 = 5 €, la cible du cahier des
# charges depuis l'ajout des suggestions de recettes, qui partagent ce même
# plafond avec le scan photo). Le quota journalier borne le nombre d'appels,
# celui-ci borne l'euro : un changement de tarif ou de modèle ne peut pas faire
# déraper la facture. 0 désactive le plafond. Le compteur est visible dans les
# réglages.
VISION_MONTHLY_CAP_CENTS=500
# Modèle essayé UNE SEULE FOIS quand Gemini refuse pour quota épuisé. Les
# quotas se comptent par modèle : basculer rouvre un réservoir intact. Vide =
# pas de repli, le refus remonte tel quel. Le choix fait dans Réglages prime.
FALLBACK_MODEL=
# Limites de requêtes par jour et par minute du projet Google, telles que
# https://aistudio.google.com/rate-limit les annonce pour VOTRE projet. Elles
# ne bloquent RIEN : purement indicatives, elles servent à afficher « 15 / 500 »
# au lieu de « 15 » dans Réglages. Aucune API ne permet de les lire, d'où la
# recopie à la main. Laissées vides, l'écran rend le compte seul — un rapport à
# une valeur inventée vaudrait moins que pas de rapport.
GEMINI_RPD=
GEMINI_RPM=

# ---- Open Food Facts ----
# Le projet demande un en-tête identifiant l'application appelante.
OFF_USER_AGENT=KitchenInventory/0.1 (self-hosted; https://github.com/djkix/kitchen-inventory)

# ---- Péremption ----
# Seuil d'alerte par défaut, modifiable ensuite dans les réglages.
EXPIRY_ALERT_DAYS=7

# ---- Journalisation ----
# fatal | error | warn | info | debug | trace. JSON sur la sortie standard.
LOG_LEVEL=info

# ---- Sauvegardes ----
# Répertoire hôte des dumps et archives. À placer de préférence sur un autre
# disque que PGDATA_DIR.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

// Inventaire alimentaire — schéma complet (lots 1 et 2)
// Les entités recettes sont créées dès maintenant même si le lot 2 est plus tard :
// ajouter des tables plus tard est indolore, ajouter une colonne à une table
// remplie de données réelles ne l'est pas.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Image Alpine amd64 (hôte de déploiement x86) : moteur musl amd64. Ajouter
  // "linux-musl-arm64-openssl-3.0.x" le jour où une image arm est publiée.
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm]
}

// ---------------------------------------------------------------- utilisateurs

enum UserRole {
  ADMIN
  MEMBER
}

// Trois états et non un booléen : « jamais validé » et « validé puis révoqué »
// ne s'affichent pas pareil (spec connexion Google, D2).
enum AccountStatus {
  PENDING
  ACTIVE
  REVOKED
}

model User {
  id                String        @id @default(cuid())
  email             String        @unique
  name              String
  // Nullable (D5) : les comptes créés par Google n'ont pas de mot de passe.
  passwordHash      String?
  googleSub         String?       @unique
  // Porte de secours (D6) : fin de validité du mot de passe à usage unique
  // posé par `tools/acces-secours.ts`. NULL = aucune porte ouverte.
  recoveryExpiresAt DateTime?
  role              UserRole      @default(MEMBER)
  status            AccountStatus @default(PENDING)
  createdAt         DateTime      @default(now())

  movements     StockMovement[]
  shoppingItems ShoppingListItem[]
  recipes       Recipe[]
  recipeLogs    RecipeLog[]
  sessions      Session[]
  preferences   UserPreference[]
  recipeRatings RecipeRating[]
  receipts      Receipt[]
}

// Réglages propres à un utilisateur, là où « Setting » vaut pour l'instance.
// Les filtres et le tri des recettes sont « mémorisés par utilisateur »
// (section 12 du cahier), chacun ayant ses habitudes.
model UserPreference {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@id([userId, key])
}

// Session par cookie httpOnly. Seul le hachage SHA-256 du jeton est stocké :
// une fuite de la base ne permet pas de rejouer les sessions.
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Jeton machine-à-machine en lecture seule (section 11, Home Assistant).
model ServiceToken {
  id         String    @id @default(cuid())
  name       String
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// Réglages d'instance modifiables depuis l'écran Réglages.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- emplacements

// Profondeur libre (décision 5) : l'arbre n'est pas limité à 3 niveaux.
// `path` stocke la chaîne d'ancêtres ("/cuisine/placard-haut/etagere-2") pour
// éviter les requêtes récursives sur les filtres par emplacement.
model Location {
  id          String   @id @default(cuid())
  name        String
  parentId    String?
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[] @relation("LocationTree")
  path        String     @unique
  depth       Int        @default(0)
  kind        String?    // libre : pièce, meuble, étagère, bac…
  temperature String?    // ambient | chilled | frozen
  sortOrder   Int        @default(0)

  stockItems StockItem[]
  receipts   Receipt[]

  @@index([parentId])
  @@index([path])
}

// ---------------------------------------------------------------- référentiel

enum Unit {
  PIECE
  GRAM
  KILOGRAM
  MILLILITER
  LITER
  PACK
  BOX
  SACHET
}

enum RecognitionSource {
  BARCODE_CACHE
  OPEN_FOOD_FACTS
  VISION
  MANUAL
}

model Category {
  id                String  @id @default(cuid())
  name              String  @unique
  parentId          String?
  parent            Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[] @relation("CategoryTree")
  icon              String?
  // Sert à estimer la DLC des périssables non emballés (décision 6).
  shelfLifeDays     Int?
  // Durée après ouverture par défaut, surchargeable au niveau produit.
  afterOpeningDays  Int?

  products          Product[]
  recipeIngredients RecipeIngredient[]

  @@index([parentId])
}

model Product {
  id         String  @id @default(cuid())
  receiptAliases ReceiptLabelAlias[]
  receiptLines   ReceiptLine[]
  barcode    String? @unique
  name       String
  // Nom d'origine tel qu'imprimé : conserve les idéogrammes (EF-04).
  originalName String?
  brand      String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  defaultUnit Unit @default(PIECE)

  // Le pont entre conditionnement et mesure : un paquet = 500 g.
  // Sans ces deux champs, une recette en grammes ne peut pas s'imputer
  // sur un stock en paquets.
  netContent     Decimal? @db.Decimal(10, 2)
  netContentUnit Unit?

  // Surcharge la valeur de la catégorie quand elle est renseignée.
  afterOpeningDays Int?

  // Repères nutritionnels d'Open Food Facts (EF-30), recopiés tels quels au
  // scan : lettre « a » à « e », et niveaux `{fat, saturated-fat, sugars,
  // salt}` valant `low`/`moderate`/`high`. Null tant qu'OFF ne les donne pas.
  nutriscoreGrade String?
  nutrientLevels  Json?

  minThreshold      Decimal? @db.Decimal(10, 2)
  imagePath         String?
  recognitionSource RecognitionSource @default(MANUAL)
  confidence        Float?

  // Produit archivé après fusion : conservé pour ne pas casser l'historique.
  mergedIntoId String?
  mergedInto   Product?  @relation("ProductMerge", fields: [mergedIntoId], references: [id])
  duplicates   Product[] @relation("ProductMerge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stockItems        StockItem[]
  recipeIngredients RecipeIngredient[]
  shoppingItems     ShoppingListItem[]

  @@index([categoryId])
  @@index([name])
  // Recherche tolérante aux fautes (EF-11) : index trigramme pour similarity().
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "Product_name_trgm_idx")
}

// ---------------------------------------------------------------- stock

enum DateType {
  USE_BY // DLC — bloquante
  BEST_BEFORE // DDM — indicative
}

model StockItem {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  locationId String
  location   Location @relation(fields: [locationId], references: [id])

  // Valeur matérialisée, recalculée depuis la somme des mouvements,
  // qui font autorité (section 8). Jamais écrite directement par une
  // consommation : on insère un mouvement et on recalcule.
  quantity Decimal @db.Decimal(10, 2)
  unit     Unit

  expiryDate  DateTime?
  dateType    DateType?
  // Vrai pour une date déduite de la catégorie, pas lue sur l'emballage.
  dateEstimated Boolean @default(false)

  opened     Boolean   @default(false)
  openedAt   DateTime?
  // min(expiryDate, openedAt + afterOpeningDays) — recalculée à l'ouverture.
  effectiveExpiry DateTime?

  purchasePrice Decimal? @db.Decimal(10, 2)
  archivedAt    DateTime?
  createdAt     DateTime  @default(now())

  movements StockMovement[]

  @@index([productId])
  @@index([locationId])
  @@index([effectiveExpiry])
}

enum MovementType {
  INBOUND
  CONSUMPTION
  ADJUSTMENT
  LOSS
  RECIPE
}

// Journal autoritaire des quantités. Une synchronisation hors ligne rejoue
// des deltas additifs, jamais des quantités absolues (section 8).
model StockMovement {
  id          String       @id @default(cuid())
  stockItemId String
  stockItem   StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        MovementType
  delta       Decimal      @db.Decimal(10, 2)
  reason      String?
  userId      String?
  user        User?        @relation(fields: [userId], references: [id])
  recipeLogId String?
  recipeLog   RecipeLog?   @relation(fields: [recipeLogId], references: [id])

  // Identifiant généré par le client : garantit qu'une opération rejouée
  // deux fois par la file hors ligne ne compte qu'une fois.
  clientOpId String?  @unique
  occurredAt DateTime @default(now())

  @@index([stockItemId])
}

// ---------------------------------------------------------------- courses

model ShoppingListItem {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  label     String?
  quantity  Decimal? @db.Decimal(10, 2)
  unit      Unit?
  checked   Boolean  @default(false)
  source    String   @default("manual") // manual | threshold | recipe
  addedById String?
  addedBy   User?    @relation(fields: [addedById], references: [id])
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- recettes

enum Difficulty {
  VERY_EASY
  EASY
  INTERMEDIATE
  HARD
}

enum DishType {
  STARTER
  MAIN
  DESSERT
  SIDE
  APERITIF
  BREAKFAST
  DRINK
}

enum Diet {
  VEGETARIAN
  VEGAN
  GLUTEN_FREE
  LACTOSE_FREE
  PORK_FREE
}

enum RecipeSource {
  HOUSEHOLD
  IMPORTED
  GENERATED
}

model Cuisine {
  id             String   @id @default(cuid())
  name           String   @unique
  // Minuscules et sans accent (A22) : permet de dédoublonner les saisies.
  normalizedName String   @unique
  region         String?
  recipes        Recipe[]
}

model Recipe {
  id        String   @id @default(cuid())
  title     String
  // Calculée automatiquement, puis corrigeable (décision 9).
  difficulty         Difficulty
  difficultyOverride Boolean @default(false)
  cuisineId String?
  cuisine   Cuisine? @relation(fields: [cuisineId], references: [id])
  dishType  DishType?
  prepMinutes  Int?
  // Temps effectivement actif en cuisine, hors repos (note sur restMinutes).
  activeTime   Int?
  cookMinutes  Int?
  // Repos (pousse, marinade…) : exclu du filtre de temps (A13).
  restMinutes  Int?
  servings     Int @default(4)
  steps        Json
  diets        Diet[]
  imagePath    String?
  source       RecipeSource @default(HOUSEHOLD)
  sourceUrl    String?
  createdById  String?
  createdBy    User?  @relation(fields: [createdById], references: [id])
  archivedAt   DateTime?
  createdAt    DateTime @default(now())
  // Idempotence de la conservation d'une suggestion (section 8, tâche 9) : une
  // recette créée hors de ce parcours n'en porte pas.
  clientOpId   String?  @unique
  // Favori et note directe (EF-21, 2026-10-08) : favori partagé par le foyer
  // (décision D4, pas de table de liaison par personne), note directe
  // indépendante de la notation par réalisation (décision D2, les deux
  // coexistent). `effectiveRating` (packages/shared) choisit laquelle
  // afficher ; cette table se contente de stocker les deux.
  favorite     Boolean  @default(false)
  rating       Int?

  ingredients RecipeIngredient[]
  logs        RecipeLog[]

  @@index([cuisineId])
  @@index([difficulty])
  @@index([archivedAt])
}

// Un ingrédient vise soit un produit précis, soit une catégorie entière
// ("des nouilles asiatiques") — c'est ce qui rend les suggestions possibles
// avec un stock hétérogène.
model RecipeIngredient {
  id         String  @id @default(cuid())
  recipeId   String
  recipe     Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  label      String
  quantity   Decimal? @db.Decimal(10, 2)
  unit       Unit?
  // Un ingrédient principal absent exclut la recette des « presque réalisables ».
  essential     Boolean @default(false)
  substitutable Boolean @default(false)

  @@index([recipeId])
  @@index([productId])
  @@index([categoryId])
}

model RecipeLog {
  id             String   @id @default(cuid())
  recipeId       String
  recipe         Recipe   @relation(fields: [recipeId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  cookedAt       DateTime @default(now())
  servingsCooked Int
  stockApplied   Boolean  @default(false)
  // Identifiant généré par le client : garantit qu'une opération rejouée
  // deux fois par la file hors ligne ne compte qu'une fois.
  clientOpId     String?  @unique

  movements StockMovement[]
  ratings   RecipeRating[]

  @@index([recipeId])
  // Rappel de notation (EF-28) : cherche la réalisation la plus récente dans
  // la fenêtre de sept jours, tous foyers confondus.
  @@index([cookedAt])
}

// Une note par membre et par réalisation (A24) : la moyenne d'une recette
// agrège les avis de tout le foyer, au lieu d'une note unique écrasée.
model RecipeRating {
  id          String    @id @default(cuid())
  recipeLogId String
  recipeLog   RecipeLog @relation(fields: [recipeLogId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stars       Int
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([recipeLogId, userId])
  @@index([recipeLogId])
}

// ---------------------------------------------------------------- traçabilité

// Partagé entre le scan (photo/code-barres) et les suggestions de recettes :
// les deux comptent sur le même plafond mensuel (B12).
enum AiPurpose {
  VISION
  RECIPE_SUGGESTION
  RECEIPT
}

// Conserve aussi les échecs : ce sont les cas à rejouer quand le modèle change.
model RecognitionLog {
  id          String    @id @default(cuid())
  imagePath   String?
  barcode     String?
  provider    String
  // Distingue le scan des suggestions de recettes dans le même journal,
  // sans rien changer au scan existant (valeur par défaut VISION).
  purpose     AiPurpose @default(VISION)
  rawResult   Json?
  confidence  Float?
  costCents   Decimal?  @db.Decimal(10, 4)
  latencyMs   Int?
  succeeded   Boolean   @default(false)
  correctedTo String?
  createdAt   DateTime  @default(now())

  @@index([createdAt])
  @@index([purpose, createdAt])
}

// Journal des requêtes réellement envoyées à Gemini (approche de Ma Cave,
// 2026-10-22) : une ligne par `generateContent`, quel que soit l'usage. Sert
// au limiteur par modèle (compteur du jour rechargé au démarrage) et à l'écran
// des modèles. Le coût reste sur `RecognitionLog`, qui sait à quel usage il
// revient. `httpStatus` nul : aucune réponse (réseau, délai).
model GeminiCall {
  id         String   @id @default(cuid())
  model      String
  httpStatus Int?
  tokens     Int?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Trace des orientations déjà demandées au modèle (D2 amendée par D11, spec
// du 2026-10-15) : plus un cache — le réservoir l'a remplacé (D8) — et plus un
// journal des réponses, que `RecognitionLog.rawResult` tient par appel. Une
// ligne par orientation, relue pour la seule question « cette question a-t-elle
// déjà été posée, et quand ? ».
model SuggestionBatch {
  id        String   @id @default(cuid())
  /** Orientation seule (région, durée, facilité, type de plat, version) : sans les graines depuis D11, donc sans le stock. */
  signature String   @unique
  model     String
  costCents Decimal? @db.Decimal(10, 4)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Réservoir permanent des recettes rapportées par le modèle (EF-26, spec du
// 2026-10-15) : une ligne par recette, jamais effacée. Remplace le TTL de 24 h
// de `SuggestionBatch`, qui ne porte plus que la trace des orientations
// demandées.
model SuggestionPoolRecipe {
  id          String    @id @default(cuid())
  /** `suggestionIdentity` (titre normalisé + URL source) : clé de dédoublonnage du réservoir (D3). */
  identity    String    @unique
  /** La `ModelRecipe` validée, revalidée à chaque lecture. */
  payload     Json
  provenance  String
  dishType    DishType
  sourceUrl   String?
  /** Lecture réussie de la page source ; `null` pour une composition du modèle, qui n'a rien à vérifier (D5). */
  verifiedAt  DateTime?
  /** `schema.org/Recipe` lu sur la page, gardé pour que la conservation ne rappelle jamais le site (D10). */
  pageRecipe  Json?
  /** Texte nettoyé de la page (plafonné à 8 000 caractères par le lecteur), repli sans données structurées. */
  pageText    String?
  model       String
  firstSeenAt DateTime  @default(now())
  lastSeenAt  DateTime  @default(now())

  @@index([dishType])
  @@index([firstSeenAt])
}

// ------------------------------------------------------------ ticket de caisse

enum ReceiptStatus {
  DRAFT
  VALIDATED
}

enum ReceiptLineState {
  MATCHED
  AMBIGUOUS
  UNKNOWN
}

// Apprentissage des libellés (EF-29) : « POULET RTI 1KG » corrigé une fois vers
// un produit n'est plus redemandé. La clé unique est le libellé normalisé.
model ReceiptLabelAlias {
  id        String   @id @default(cuid())
  label     String   @unique
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@index([productId])
}

// Un ticket en brouillon se relit et se corrige avant d'entrer au stock ; il ne
// porte aucun prix (non-objectif du cahier).
model Receipt {
  id          String        @id @default(cuid())
  locationId  String
  // Un ticket sans emplacement n'a pas de sens, et son stock est déjà versé
  // (les `StockItem` ne dépendent pas de lui) : supprimer l'emplacement
  // emporte le ticket plutôt que de rendre la suppression impossible.
  location    Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  status      ReceiptStatus @default(DRAFT)
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  lines ReceiptLine[]

  @@index([locationId])
  @@index([createdById])
}

model ReceiptLine {
  id        String  @id @default(cuid())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  // Conserve l'ordre d'impression du ticket.
  position  Int
  rawLabel  String
  quantity  Decimal @db.Decimal(10, 2)
  // NULL tant que la ligne est AMBIGUOUS ou UNKNOWN.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  state     ReceiptLineState
  // Produits possibles d'une ligne ambiguë.
  candidateIds String[]

  @@index([receiptId, position])
  @@index([productId])
}

// Tentatives de sauvegarde vers le NAS (section 9), inscrites par
// docker/backup/backup.sh en SQL brut — d'où l'identifiant entier généré par
// la base. Message technique seulement (« étape base (code 1) »), jamais de
// contenu de l'inventaire. Lue par Réglages › Sauvegarde.
model BackupAttempt {
  id         Int      @id @default(autoincrement())
  startedAt  DateTime
  finishedAt DateTime
  succeeded  Boolean
  message    String
  // Taille du dump de la base, pour une tentative réussie.
  dumpBytes  Int?

  @@index([finishedAt])
}

// « Sauvegarder maintenant » (Réglages, administrateurs) : une ligne posée par
// l'API, effacée par docker/backup/schedule.sh au passage suivant (5 minutes).
model BackupRequest {
  id          Int      @id @default(autoincrement())
  requestedAt DateTime @default(now())
}
